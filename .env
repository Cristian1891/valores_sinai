# .env.example
# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas .env a git. Asegurate de tenerlo en .gitignore.

# ── MercadoPago — Links de pago ────────────────────────────────
# Generá los links en: mercadopago.com.ar → Herramientas → Link de pago
VITE_MP_ACADEMY=https://link.mercadopago.com.ar/valoressinai
VITE_MP_SOLIDARITY=https://link.mercadopago.com.ar/valoressinai

# VITE_MP_ACADEMY=https://link.mercadopago.com.ar/freyagalindo
# VITE_MP_SOLIDARITY=https://link.mercadopago.com.ar/freyagalindo

# ── Geolocalización por IP (opcional) ─────────────────────────
# Mejora la detección del país del donante para mostrar comisiones exactas.
# Token gratuito en: https://ipinfo.io/signup (50.000 req/mes)
# Si lo dejás vacío, usa BigDataCloud como fallback (también gratuito).
VITE_IPINFO_TOKEN=4f3af741578db5


VITE_TESTIMONIALS_API=https://script.google.com/macros/s/AKfycbzmLy2oN2Bbk7RJ44X89dvWszXYZ0wyyvYTs0fARejsqtZfsSyb1hLOLiCnfv9xk9Du/exec

